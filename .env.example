# Mẫu cấu hình. Copy thành .env rồi sửa đường dẫn theo máy của bạn.
# .env là file riêng của từng máy và đã nằm trong .gitignore — đừng commit nó.
#
# Ghi chú: app đọc .env bằng setdefault, nên biến truyền tường minh khi chạy
# lệnh (ví dụ `AIC_USE_DUMMY=1 python -m uvicorn ...`) luôn thắng file này.

# --- Chế độ chạy -----------------------------------------------------------
# 1 = dùng dữ liệu giả để thử UI. 0 = production, dùng index thật.
# Ở chế độ 0, nguồn nào hỏng sẽ báo "error" trong /api/status chứ không âm thầm
# thay bằng dummy.
AIC_USE_DUMMY=0

# --- Khởi tạo thành phần ---------------------------------------------------
# Mọi thành phần nặng (model dịch, CLIP, BM25) đều nạp LƯỜI và có ô trạng thái
# riêng trong /api/status: disabled / idle / loading / ready / error. Một thành
# phần hỏng chỉ làm hỏng chính nó; /api/translate không phụ thuộc CLIP hay BM25.
#
# AIC_PRELOAD điều khiển warm-up NỀN sau khi server đã bind port (không bao giờ
# chặn startup):
#   để trống hoặc "all" = translation,clip,bm25,siglip (mặc định)
#   "none"              = không nạp trước gì cả, chờ request đầu tiên
#   danh sách tự chọn   = ví dụ "translation,bm25"
# Translation đứng đầu vì operator bấm "dịch" trước khi bấm "tìm".
# AIC_PRELOAD=all

# Đường dẫn artifact được phân giải theo thứ tự: biến môi trường bên dưới (nếu
# file THỰC SỰ tồn tại) → tải từ Hugging Face. Trỏ sai đường dẫn thì app ghi
# WARNING rồi mới quay sang Hugging Face.

# --- Dữ liệu hiển thị ------------------------------------------------------
AIC_KEYFRAMES_DIR=/duong/dan/toi/keyframes
# Bảng video_id → {path, fps} cho /api/video và /api/video_info. Không đặt thì
# tải từ Hugging Face.
# AIC_VIDEO_METADATA_PATH=/duong/dan/toi/local/video_metadata.json

# --- CLIP (bắt buộc) -------------------------------------------------------
AIC_INDEX_PATH=/duong/dan/toi/index/clip_faiss.index
AIC_META_PATH=/duong/dan/toi/index/clip_metadata.json
# Model text phải khớp cách index được dựng. Index hiện tại dựng từ
# clip-features-32 của BTC (clip-ViT-B-32, trọng số OpenAI, 512 chiều).
# AIC_CLIP_MODEL=ViT-B-32-quickgelu
# AIC_CLIP_PRETRAINED=openai
# AIC_CLIP_DEVICE=auto

# --- BM25 (bắt buộc) -------------------------------------------------------
AIC_TEXT_INDEX_PATH=/duong/dan/toi/index/text_search_index.pkl

# --- SigLIP2 (tuỳ chọn) ----------------------------------------------------
# Không đặt hai biến này thì SigLIP báo "disabled" chứ không phải lỗi.
# AIC_SIGLIP_INDEX_PATH=/duong/dan/toi/index/siglip_faiss.index
# AIC_SIGLIP_META_PATH=/duong/dan/toi/index/siglip_metadata.json
# Index hiện tại dựng bằng open_clip 'hf-hub:timm/ViT-SO400M-14-SigLIP2'
# (1152 chiều). Đổi sang model khác cùng số chiều vẫn chạy nhưng sai không gian
# embedding, nên chỉ đổi khi index cũng được dựng lại.
# AIC_SIGLIP_MODEL=hf-hub:timm/ViT-SO400M-14-SigLIP2
# AIC_SIGLIP_DEVICE=auto

# --- Dịch VI→EN ------------------------------------------------------------
# AIC_TRANSLATION_DEVICE=auto
# AIC_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-vi-en

# --- Tuỳ chọn chung --------------------------------------------------------
# Thư mục cache HuggingFace, để trống thì dùng mặc định của HuggingFace.
# AIC_HF_CACHE_DIR=/duong/dan/toi/hf_cache
# =1 để tắt toàn bộ model neural (CLIP/SigLIP), chỉ chạy BM25.
# AIC_DISABLE_NEURAL=0

# Thư mục map-keyframes của BTC (<video_id>.csv có cột fps chính xác).
# Không đặt thì fps được suy từ metadata keyframe, kém chính xác hơn.
# AIC_MAP_KEYFRAMES_DIR=/duong/dan/toi/index/map-keyframes/map-keyframes

# --- Cấu hình Hugging Face Dataset (Tải tự động) -----------------------------
# ID của dataset lưu trữ index và metadata trên Hugging Face
AIC_HF_REPO_ID=manhha2502/fullhd
# Revision/Tag/Commit Hash cụ thể của dataset để đảm bảo đồng bộ phiên bản
AIC_HF_REVISION=main
# Thư mục cache tải về (để trống sẽ dùng cache mặc định của Hugging Face)
AIC_HF_CACHE_DIR=
# Đường dẫn gốc tải video media từ Hugging Face
AIC_HF_DATASET_URL=https://huggingface.co/datasets/manhha2502/fullhd/resolve/main
# 1 = Bật SigLIP (sẽ tự động tải index/metadata từ Hugging Face), 0 = Tắt
AIC_USE_SIGLIP=0
